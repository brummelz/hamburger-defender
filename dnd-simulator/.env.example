# Copy this file to .env and fill in your keys.

# Anthropic API key (https://console.anthropic.com/) - optional.
# When set, Claude plays the Dungeon Master. When left blank, the server
# falls back to Gemini for narration too, so GEMINI_API_KEY alone is enough
# to run the whole app.
ANTHROPIC_API_KEY=

# Google AI Studio / Gemini API key (https://aistudio.google.com/apikey)
# Required. Powers scene illustrations always, and powers the Dungeon
# Master narration whenever ANTHROPIC_API_KEY is not set.
GEMINI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PORT=3000
