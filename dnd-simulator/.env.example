# Copy this file to .env and fill in your keys.

# Anthropic API key (https://console.anthropic.com/) - powers the Dungeon Master
ANTHROPIC_API_KEY=

# Google AI Studio / Gemini API key (https://aistudio.google.com/apikey) - powers scene illustrations
GEMINI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PORT=3000
